{
  "name": "wick",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Keeps your Mac awake: on demand, for a time, or while an app or process runs.",
  "license": "MIT",
  "author": "abulkosim <abulkasimkattaev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abulkosim/wick.git"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vue-tsc": "3.3.14"
  }
}
