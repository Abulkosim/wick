<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.abulkosim.wick</id>
  <name>Wick</name>
  <summary>Keep your computer awake</summary>
  <developer id="io.github.abulkosim">
    <name>abulkosim</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>Wick keeps your computer awake from the panel's tray: on demand, for a set time, or while something is running.</p>
    <ul>
      <li>Sessions until stopped, for 15 minutes to 7 days, or until a time</li>
      <li>Triggers: while the network or CPU is busy, on power, with an external display, or on a schedule</li>
      <li>Stops below a battery level you choose</li>
      <li>Shows which other apps are keeping the computer awake</li>
      <li>Keeps the display on only when you ask</li>
    </ul>
    <p>Wick uses your desktop's own inhibitors and a systemd-logind lock, and changes no system settings. Quitting releases them at once. No account, no telemetry.</p>
  </description>
  <launchable type="desktop-id">io.github.abulkosim.wick.desktop</launchable>
  <url type="homepage">https://abulkosim.github.io/wick/</url>
