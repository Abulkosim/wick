{
  "build": {
    "features": ["console-cli"]
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Wick", "width": 360, "height": 640,
      "visible": false, "resizable": false, "decorations": false,
      "transparent": true, "shadow": true, "alwaysOnTop": true,
      "skipTaskbar": true, "center": true,
      "windowEffects": { "effects": ["mica", "acrylic"] }
    }]
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/command-line.wxs"],
        "componentRefs": ["WickCommandLine"]
      }
    }
  }
}
